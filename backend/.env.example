# Backend environment variables — copy to .env and fill in values

# --- App ---
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string-in-production
ENCRYPTION_KEY=change-me-to-a-different-long-random-string

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./creds_manager.db
# For PostgreSQL: postgresql+asyncpg://user:password@localhost:5432/creds_manager

# --- Auth ---
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:3000

# --- Redis (vault key cache) ---
REDIS_URL=redis://localhost:6379/0
VAULT_KEY_CACHE_TTL_SECONDS=3600
# PBKDF2_ITERATIONS: 600000 is the OWASP minimum for PBKDF2-SHA256
PBKDF2_ITERATIONS=600000

# --- Email (Resend) ---
# Leave RESEND_API_KEY empty in dev — emails are logged to console instead
RESEND_API_KEY=
EMAIL_FROM=Vault <noreply@yourdomain.com>
APP_BASE_URL=http://localhost:3000

# --- Auth hardening ---
REQUIRE_EMAIL_VERIFICATION=false
RATE_LIMITING_ENABLED=true

# --- Pagination ---
DEFAULT_PAGE_SIZE=12
MAX_PAGE_SIZE=100

# --- Activity log ---
ENABLE_ACTIVITY_LOGGING=true
ACTIVITY_LOG_RETENTION_DAYS=90
